import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';
import { getCurrentUserFromRequest } from '@/lib/auth';
import { getSimpleShop, transferShopOwnership } from '@/lib/simple-shop';
import { setApporteur, setReferent } from '@/lib/referents';
import { createNotif } from '@/lib/notifs';
import { getUserById } from '@/lib/db';

export const runtime = 'nodejs';
export const dynamic = 'force-dynamic';

interface Params { params: Promise<{ id: string }> }

// POST { client_id } — « Donner à un client » : le PROPRIÉTAIRE transfère la fiche à un client.
// Le donneur reste apporteur + référent (garde l'accès jusqu'à ce que le client le retire).
export async function POST(req: NextRequest, ctx: Params) {
  const me = getCurrentUserFromRequest(req);
  if (!me) return NextResponse.json({ error: 'unauthorized' }, { status: 401 });
  const { id } = await ctx.params;
  const shop = getSimpleShop(id);
  if (!shop || shop.owner_id !== me.id) return NextResponse.json({ error: 'not_found' }, { status: 404 });
  let body: { client_id?: string } = {};
  try { body = await req.json(); } catch { /* */ }
  const clientId = String(body.client_id || '').trim();
  if (!clientId || clientId === me.id) return NextResponse.json({ error: 'invalid_client' }, { status: 400 });
  const client = getUserById(clientId);
  if (!client) return NextResponse.json({ error: 'client_not_found' }, { status: 404 });

  const r = transferShopOwnership(id, me.id, clientId);
  if (!r.ok) return NextResponse.json({ error: r.error }, { status: 400 });

  // Je reste apporteur + référent → je garde l'accès jusqu'à ce que le client me retire.
  try { setApporteur(id, me.id); } catch { /* déjà apporteur */ }
  try { setReferent(id, me.id, clientId, 'don au client'); } catch { /* */ }

  // Notif au nouveau propriétaire (le client sait qu'on lui a confié une fiche).
  try {
    const meU = getUserById(me.id) as { display_name?: string; username?: string } | null;
    const who = meU?.display_name || meU?.username || 'Un contributeur';
    createNotif(clientId, 'shop_received', 'Une boutique t\'a été confiée',
      `${who} t'a donné la propriété de « ${shop.name} ». Elle est à toi — tu peux la gérer, et retirer ton référent quand tu veux.`);
  } catch { /* best-effort */ }

  return NextResponse.json({ ok: true, client: { id: client.id, name: (client as { display_name?: string; username?: string }).display_name || (client as { username?: string }).username || 'Client' } });
}
