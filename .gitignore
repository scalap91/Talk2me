# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Talk2Me — données runtime (JAMAIS dans git : doctrine PII air-gap)
# DB SQLite = talk2me_id / emails / passwords / tokens / IP
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Médias uploadés par les users (vidéos/images de cards)
/public/uploads

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.firebase-admin.json

# cron audit output (régénéré)
/reports/feature-registry/
.next-*
