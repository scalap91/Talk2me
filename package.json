{
  "name": "talktome",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "./lib/db.ts",
    "./lib/db/**/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "fuzz": "node scripts/ai-fuzz-tester/index.mjs",
    "fuzz:regression": "node scripts/ai-fuzz-tester/index.mjs --regression",
    "fuzz:list-bugs": "node scripts/ai-fuzz-tester/index.mjs --list-bugs",
    "fuzz:cleanup": "node scripts/ai-fuzz-tester/index.mjs --cleanup",
    "ai-ops:daemon": "node scripts/ai-ops-daemon.mjs",
    "ai-ops:dry-run": "AI_OPS_DRY_RUN=true AI_OPS_MAX_CYCLES=3 AI_OPS_CYCLES_PER_HOUR=120 node scripts/ai-ops-daemon.mjs",
    "features:check": "node tests/feature-registry/runner.mjs",
    "features:list": "node tests/feature-registry/runner.mjs --list",
    "features:broken": "node tests/feature-registry/runner.mjs --list --broken",
    "features:add": "node tests/feature-registry/add.mjs",
    "features:cron": "node tests/feature-registry/runner.mjs --cron --interval-min=60",
    "features:drift": "node tests/feature-registry/drift.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@mozilla/readability": "^0.6.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react-syntax-highlighter": "^15.5.13",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "isomorphic-dompurify": "^3.15.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.17.0",
    "mediasoup": "^3.19.3",
    "mediasoup-client": "^3.18.7",
    "mermaid": "^11.15.0",
    "next": "16.2.7",
    "openai": "^6.41.0",
    "opening_hours": "^3.12.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "stockfish": "^18.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
